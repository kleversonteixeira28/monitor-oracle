# Este arquivo e o MOLDE. Voce nao edita ele no servidor.
# O instalador cria /opt/monitor/.env com senhas aleatorias e chmod 600.
# Chave nova adicionada aqui aparece sozinha no .env na proxima sincronizacao.
# Valor "GERAR" vira uma senha aleatoria de 24 caracteres.

# --- Como o servidor e acessado -------------------------------------------
# MODO=oracle  maquina exposta na internet, com IP publico.
#              O Caddy tira o certificado (Let's Encrypt) e as portas 80/443
#              precisam estar abertas no firewall da nuvem.
# MODO=tunel   maquina na sua rede (mini PC na loja), publicada pelo Cloudflare
#              Tunnel. NENHUMA porta do roteador e aberta: o cloudflared faz
#              conexao de SAIDA. Quem termina o HTTPS e a Cloudflare, entao o
#              Caddy fica so no 127.0.0.1 e nao tenta certificado nenhum.
# MODO=tailscale maquina na sua rede, numa rede privada Tailscale. Sem dominio,
#              sem DNS, sem nada exposto na internet: so quem esta no seu
#              tailnet enxerga. E o caminho mais curto quando os paineis sao
#              so para voce.
MODO=oracle
# Preenchidas sozinhas pelo instalar-tailscale.sh. Nao mexa.
TAILSCALE_HOST=
TAILSCALE_URL=

# Com MODO=tunel o DOMINIO e obrigatorio, e o dominio precisa estar com os
# nameservers na Cloudflare.
# Com MODO=oracle, vazio = acesso por IP e porta, sem HTTPS.
#   grafana.SEU-DOMINIO  zabbix.SEU-DOMINIO  status.SEU-DOMINIO  docker.SEU-DOMINIO
DOMINIO=
# So usado no MODO=oracle (registro no Let's Encrypt).
EMAIL_TLS=

TZ=America/Sao_Paulo

# --- Banco do Zabbix -------------------------------------------------------
POSTGRES_USER=zabbix
POSTGRES_PASSWORD=GERAR
POSTGRES_DB=zabbix

# --- Senhas das interfaces -------------------------------------------------
# O Zabbix nasce com Admin/zabbix; o configurar-zabbix.sh troca para esta.
ZABBIX_ADMIN_SENHA=GERAR
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_SENHA=GERAR
PORTAINER_SENHA=GERAR

# --- Retencao --------------------------------------------------------------
PROMETHEUS_RETENCAO=30d
BACKUP_DIAS=7
