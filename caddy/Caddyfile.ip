# MODO IP - sem dominio, sem HTTPS. Serve para comecar; troque assim que
# tiver um dominio (basta preencher DOMINIO no .env e esperar 5 min).
{
	auto_https off
}

(comum) {
	encode zstd gzip
	header {
		X-Content-Type-Options "nosniff"
		-Server
	}
}

:3000 {
	import comum
	reverse_proxy grafana:3000
}

:8080 {
	import comum
	reverse_proxy zabbix-web:8080
}

:3001 {
	import comum
	reverse_proxy uptime-kuma:3001
}

:9000 {
	import comum
	reverse_proxy portainer:9000
}

:80 {
	redir http://{host}:3000{uri}
}
